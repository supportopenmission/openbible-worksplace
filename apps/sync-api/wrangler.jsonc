{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openbible-sync-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-07",
	"d1_databases": [
    {
      "binding": "openbible_sync",
      "database_name": "openbible-sync",
