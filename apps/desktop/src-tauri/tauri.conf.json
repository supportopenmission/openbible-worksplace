{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "OpenBible",
	"version": "0.5.3",
	"identifier": "org.openbible.desktop",
	"build": {
		"beforeDevCommand": "bun run --cwd ../web dev -- --host 127.0.0.1",
		"devUrl": "http://127.0.0.1:5173",
		"beforeBuildCommand": "TAURI_BUILD=1 bun run --cwd ../web build",
		"frontendDist": "../../web/.svelte-kit/tauri"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"title": "OpenBible",
				"width": 1280,
				"height": 840,
				"minWidth": 960,
				"minHeight": 640,
				"resizable": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["app", "dmg"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"category": "Productivity",
		"shortDescription": "Estudos bíblicos locais",
		"longDescription": "OpenBible para leitura da Bíblia, notas, estudos e sermões.",
		"macOS": {
			"minimumSystemVersion": "13.0"
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2REFEQzM5QURGMDRGMjgKUldRb1QvQ3RPZHphOWhxUDI4STBIWHZYaEI2TWM5WGRPRldENUNjSDBUNG9MVmNhUWVUOFZDWWsK",
			"endpoints": [
				"https://github.com/supportopenmission/openbible-worksplace/releases/latest/download/latest.json"
			]
		}
	}
}
