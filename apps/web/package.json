{
  "name": "web",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "preview": "bun run build && wrangler dev --host",
    "version:sync": "node scripts/sync_app_version.mjs",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload",
    "check-types": "svelte-kit sync && tsc --noEmit",
    "check": "svelte-kit sync && tsc --noEmit",
    "check:watch": "svelte-kit sync && tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:tdd": "vitest run"
  },
  "dependencies": {
    "@friendofsvelte/tipex": "0.2.0",
    "@milkdown/kit": "7.22.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tiptap/extension-highlight": "2.27.2",
    "bible-passage-reference-parser": "^4.0.0",
    "clsx": "^2.1.1",
    "remark-directive": "^4.0.0",
    "sql.js": "^1.14.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.39.0",
    "@playwright/test": "1.62.1",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "catalog:sveltejs",
    "@sveltejs/vite-plugin-svelte": "catalog:sveltejs",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.2.0",
    "@types/sql.js": "^1.4.11",
    "@vitest/browser-playwright": "4.1.10",
    "bits-ui": "^2.16.3",
    "eslint": "10.8.1",
    "prettier-plugin-svelte": "catalog:sveltejs",
    "svelte": "catalog:sveltejs",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tslib": "2.8.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vitest-browser-svelte": "3.0.0",
    "wrangler": "^4.127.1"
  }
