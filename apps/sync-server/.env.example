# Porta e configurações do servidor de sincronização
PORT=8787
BETTER_AUTH_URL=http://localhost:8787
# Gere um valor aleatório com: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Origens do apps/web separadas por vírgula (não inclua espaços)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
