{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "openbible-sync-server",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "openbible_sync",
			"database_name": "openbible-sync",
			"database_id": "0ca52e95-b174-423c-af02-76a87be7c3b0",
			"migrations_dir": "drizzle"
		}
	],
	"vars": {
		"MAX_BATCH_SIZE": "50",
		"MAX_PAYLOAD_BYTES": "262144",
		"BETTER_AUTH_URL": "https://openbible-sync-server.contato-207.workers.dev",
		"BETTER_AUTH_TRUSTED_ORIGINS": "https://openbible.contato-207.workers.dev"
	}
}
